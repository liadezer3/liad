# ---------------------------------------------------------------------------
# Dividend Growth Stock Evaluator - Backend Configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.

# CORS: comma separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# AI Prompt Layer
# ---------------------------------------------------------------------------
# The AI dividend-safety analysis works in two modes:
#   1. "llm"       - calls a real OpenAI-compatible chat completion endpoint
#   2. "heuristic" - deterministic local scoring (no network / no key needed)
#
# If AI_PROVIDER is "llm" but no API key is supplied, the service automatically
# falls back to the heuristic engine so the app always returns a result.
AI_PROVIDER=heuristic

# OpenAI-compatible settings (only used when AI_PROVIDER=llm)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Market Data
# ---------------------------------------------------------------------------
# When live market data cannot be reached (offline / rate limited), the API
# serves bundled sample fixtures instead of failing. Set to "false" to disable.
ENABLE_SAMPLE_FALLBACK=true
